# Local foaf-auth (Job 41-43 cutover). foaf-auth/service docker-compose
# runs on host port 3013; railsbackend container reaches it via
# host.docker.internal. Service token from local foaf-auth's
# auth:service_tokens:issue (label=railsbackend-dev).
FOAF_AUTH_BASE_URL=http://host.docker.internal:3013
# Local auth can lag remote demo identity data; public avatar reads can use
# demo auth without changing login, token verification, or service-token calls.
FOAF_AUTH_PUBLIC_BASE_URL=https://dauth.foaf.io
FOAF_AUTH_ISSUER=auth.foaf.io
FOAF_AUTH_JWKS_URL=http://host.docker.internal:3013/.well-known/jwks.json
FOAF_AUTH_REVOCATION_SNAPSHOT_URL=http://host.docker.internal:3013/v1/revocations/snapshot
