#!/bin/bash
#
# End-to-end trade test. Restores a clean snapshot, then drives real API
# calls across multiple demo users to exercise the request → accept → ship
# → sign → settle flow. After every browser-equivalent action, the script
# checks a set of data-integrity invariants against the DB and bails on
# the first violation.
#
# Usage (from railsbackend/):
#   ./bin/foaf-trade-test [snapshot_date]
#
# Exit codes:
#   0 — all scenarios passed
#   1 — invariant violation (details in output)
#   2 — API error that blocked the test

set -euo pipefail

SNAPSHOT_DATE="${1:-2026-05-23}"
TRADE_TEST_HOST="${TRADE_TEST_HOST:-http://localhost:3001}"
TRADE_TEST_HOST="${TRADE_TEST_HOST%/}"

case "${TRADE_TEST_HOST}" in
  http://localhost:3001|http://127.0.0.1:3001)
    RESET_MODE="local"
    ;;
  https://demo.growoperative.app|https://dpi.growoperative.app)
    RESET_MODE="demo"
    ;;
  *)
    echo "REFUSED: unsupported TRADE_TEST_HOST '${TRADE_TEST_HOST}'."
    echo "         Allowed: localhost:3001, demo.growoperative.app, dpi.growoperative.app."
    exit 2
    ;;
esac

export TRADE_TEST_HOST

echo "=== FOAF Trade Test ==="
echo "  Host: ${TRADE_TEST_HOST}"
echo "  Reset mode: ${RESET_MODE}"
echo
echo "[A] Reset ($SNAPSHOT_DATE)"
if [[ "${RESET_MODE}" == "demo" ]]; then
  ./bin/foaf-reset-demo "$SNAPSHOT_DATE" > /tmp/trade_test_reset.log 2>&1
else
  ./bin/foaf-reset "$SNAPSHOT_DATE" > /tmp/trade_test_reset.log 2>&1
fi || {
  echo "  Reset failed. See /tmp/trade_test_reset.log"
  exit 2
}
echo "  OK"
echo

if [[ "${RESET_MODE}" == "demo" ]]; then
  echo "[A.1] Wait for demo backend after reset"
  for attempt in {1..30}; do
    if curl -fsS "${TRADE_TEST_HOST}/v1/debug/invariants" > /dev/null; then
      echo "  OK"
      break
    fi
    if [[ "${attempt}" -eq 30 ]]; then
      echo "  Demo backend did not become ready after 30 seconds."
      exit 2
    fi
    sleep 1
  done
  echo
fi

echo "[B] Run scenarios (Python driver, via HTTP)"
echo
python3 scripts/trade_test.py
