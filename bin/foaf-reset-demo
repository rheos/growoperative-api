#!/usr/bin/env bash
#
# Reset the deployed demo to a clean trade-test baseline.
#
# Empties the allowlisted growoperative_demo schema, loads a dev_clean_*
# snapshot, then wipes foaf_testnet so the FOAF side also starts empty.
# Emptying the schema first is required because an older snapshot cannot
# contain DROP statements for tables introduced by newer migrations.
# Ledger hooks will populate FOAF as the test creates trades.
#
# Uses PostgreSQL connection URLs from the running demo containers; the script
# never needs direct host credentials.
#
# This is the remote equivalent of bin/foaf-reset, run against the deployed
# demo containers.
#
# Usage (ON SERVER, from ~/railsbackend/):
#   ./bin/foaf-reset-demo [snapshot_file]
#
# Usage (FROM ANOTHER MACHINE):
#   ssh <demo-host> 'cd ~/growoperative-api && ./bin/foaf-reset-demo'
#
# Snapshot is restricted to dev_clean_* PostgreSQL SQL dumps. The trade test
# requires a starting state with no pre-existing requests, orders, contracts,
# or trustlines — other snapshots would invalidate it.
#
# Exit codes:
#   0  reset succeeded
#   1  bad snapshot or missing prerequisite
#   2  DB/container operation failed

set -euo pipefail

SNAPSHOT_DATE="${1:-2026-05-23}"
RB_DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
SNAPSHOT_DIR="${RB_DIR}/db/snapshots"
PGCLIENT_IMAGE="${PGCLIENT_IMAGE:-postgres:16}"
BACKEND_CONTAINER="railsbackend-backend-demo-1"
AUTH_CONTAINER="foaf-auth-auth-demo-1"
FOAF_CONTAINER="foaf-testnet"

# --- Hard allowlist: refuse to touch anything but demo, dauth, and testnet -
# These are the ONLY targets this script is allowed to wipe. If any of these
# expectations is violated, abort before any destructive operation.
EXPECTED_APP_DB="growoperative_demo"
EXPECTED_AUTH_DB="foaf_auth_demo"
EXPECTED_FOAF_NETWORK="testnet"

find_snapshot() {
  local prefix="$1"
  local date="$2"
  local ext
  local path

  for ext in sql sql.gz dump backup tar; do
    path="${SNAPSHOT_DIR}/${prefix}_${date}.${ext}"
    if [[ -f "${path}" ]]; then
      printf '%s\n' "${path}"
      return 0
    fi
  done

  return 1
}

postgres_snapshot_header() {
  local path="$1"

  case "${path}" in
    *.sql) head -n 20 "${path}" ;;
    *.sql.gz) gzip -dc "${path}" | head -n 20 ;;
    *) return 0 ;;
  esac
}

assert_postgres_snapshot() {
  local path="$1"

  case "${path}" in
    *.sql|*.sql.gz)
      if ! postgres_snapshot_header "${path}" | grep -q "PostgreSQL database dump"; then
        echo "ERROR: ${path} does not look like a PostgreSQL dump."
        echo "       MySQL-era snapshots are not supported. Recreate it with pg_dump."
        exit 1
      fi
      ;;
    *.dump|*.backup|*.tar)
      ;;
    *)
      echo "ERROR: Unsupported snapshot format: ${path}"
      echo "       Expected a PostgreSQL dump ending in .sql, .sql.gz, .dump, .backup, or .tar."
      exit 1
      ;;
  esac
}

container_database_url() {
  local container="$1"
  docker exec "${container}" printenv DATABASE_URL 2>/dev/null | tr -d '\r'
}

database_name_from_url() {
  local url="$1"
  local no_query="${url%%\?*}"
  printf '%s\n' "${no_query##*/}"
}

psql_with_url() {
  local network_container="$1"
  local database_url="$2"
  shift 2

  docker run --rm -i \
    --network "container:${network_container}" \
    -e DATABASE_URL="${database_url}" \
    "${PGCLIENT_IMAGE}" \
    sh -lc 'exec psql "$DATABASE_URL" -v ON_ERROR_STOP=1 "$@"' sh "$@"
}

pg_restore_with_url() {
  local network_container="$1"
  local database_url="$2"
  local snapshot_path="$3"

  docker run --rm \
    --network "container:${network_container}" \
    -e DATABASE_URL="${database_url}" \
    -v "$(dirname "${snapshot_path}"):/snapshots:ro" \
    "${PGCLIENT_IMAGE}" \
    sh -lc 'exec pg_restore --clean --if-exists --no-owner --no-privileges -d "$DATABASE_URL" "$1"' sh \
    "/snapshots/$(basename "${snapshot_path}")"
}

restore_snapshot_to_url() {
  local network_container="$1"
  local database_url="$2"
  local snapshot_path="$3"

  case "${snapshot_path}" in
    *.sql)
      psql_with_url "${network_container}" "${database_url}" < "${snapshot_path}"
      ;;
    *.sql.gz)
      gzip -dc "${snapshot_path}" | psql_with_url "${network_container}" "${database_url}"
      ;;
    *.dump|*.backup|*.tar)
      pg_restore_with_url "${network_container}" "${database_url}" "${snapshot_path}"
      ;;
  esac
}

APP_SNAPSHOT_PATH="$(find_snapshot "dev_clean" "${SNAPSHOT_DATE}" || true)"
AUTH_SNAPSHOT_PATH="$(find_snapshot "auth_clean" "${SNAPSHOT_DATE}" || true)"
APP_SNAPSHOT="$(basename "${APP_SNAPSHOT_PATH:-missing}")"
AUTH_SNAPSHOT="$(basename "${AUTH_SNAPSHOT_PATH:-missing}")"

# --- Safety: snapshots must be a clean baseline ----------------------------
if [[ -z "${APP_SNAPSHOT_PATH}" ]]; then
  echo "ERROR: App snapshot not found for ${SNAPSHOT_DATE} in ${SNAPSHOT_DIR}"
  echo "       Expected a PostgreSQL dump named dev_clean_${SNAPSHOT_DATE}.{sql,sql.gz,dump,backup,tar}"
  exit 1
fi

if [[ -z "${AUTH_SNAPSHOT_PATH}" ]]; then
  echo "ERROR: Auth snapshot not found for ${SNAPSHOT_DATE} in ${SNAPSHOT_DIR}"
  echo "       Both halves are required so users.foaf_id and identities.foaf_id stay aligned."
  exit 1
fi

assert_postgres_snapshot "${APP_SNAPSHOT_PATH}"
assert_postgres_snapshot "${AUTH_SNAPSHOT_PATH}"

# Snapshot must be transactionally empty. The dev_clean_* prefix is a name
# convention; this check is the actual contract. If a snapshot somehow ended
# up with orders/trustlines/etc baked in, refuse rather than silently load it.
case "${APP_SNAPSHOT_PATH}" in
  *.sql) SNAPSHOT_STREAM=(cat "${APP_SNAPSHOT_PATH}") ;;
  *.sql.gz) SNAPSHOT_STREAM=(gzip -dc "${APP_SNAPSHOT_PATH}") ;;
  *)
    echo "REFUSED: ${APP_SNAPSHOT_PATH} is not a plain PostgreSQL SQL dump."
    echo "         Demo resets inspect the snapshot before loading it, so use .sql or .sql.gz here."
    exit 1
    ;;
esac

TRANSACTIONAL_TABLES=(trustlines trustline_transactions orders item_requests request_contracts pending_payments)
for tbl in "${TRANSACTIONAL_TABLES[@]}"; do
  if "${SNAPSHOT_STREAM[@]}" | grep -Eq "COPY public\\.${tbl}\\b|INSERT INTO public\\.${tbl}\\b"; then
    echo "REFUSED: ${APP_SNAPSHOT_PATH} contains rows for ${tbl}."
    echo "         Trade-test snapshots must have zero transactional rows."
    echo "         Recreate the dump after clearing transactional data and retry."
    exit 1
  fi
done

# --- Sanity: required containers running -----------------------------------
for c in "${BACKEND_CONTAINER}" "${AUTH_CONTAINER}" "${FOAF_CONTAINER}"; do
  if ! docker ps --format '{{.Names}}' | grep -qx "${c}"; then
    echo "ERROR: container ${c} not running. Can't proceed."
    exit 2
  fi
done

APP_DATABASE_URL="$(container_database_url "${BACKEND_CONTAINER}")"
AUTH_DATABASE_URL="$(container_database_url "${AUTH_CONTAINER}")"
APP_DB_NAME="$(database_name_from_url "${APP_DATABASE_URL}")"
AUTH_DB_NAME="$(database_name_from_url "${AUTH_DATABASE_URL}")"

if [[ -z "${APP_DATABASE_URL}" || -z "${AUTH_DATABASE_URL}" ]]; then
  echo "ERROR: unable to read DATABASE_URL from ${BACKEND_CONTAINER} / ${AUTH_CONTAINER}"
  exit 2
fi

# --- Allowlist guards: both DBs must be the demo ones ---------------------
if [[ "${APP_DB_NAME}" != "${EXPECTED_APP_DB}" ]]; then
  echo "REFUSED: app DATABASE_NAME is '${APP_DB_NAME}', not '${EXPECTED_APP_DB}'."
  echo "         This script only wipes the demo app database. Aborting."
  exit 1
fi
if [[ "${AUTH_DB_NAME}" != "${EXPECTED_AUTH_DB}" ]]; then
  echo "REFUSED: auth DATABASE_NAME is '${AUTH_DB_NAME}', not '${EXPECTED_AUTH_DB}'."
  echo "         This script only wipes the dauth demo database. Aborting."
  exit 1
fi

# --- Allowlist guard: foaf container must be running as testnet -----------
FOAF_NETWORK_ACTUAL="$(docker exec "${FOAF_CONTAINER}" sh -c 'echo $FOAF_NETWORK' 2>/dev/null || echo '')"
if [[ "${FOAF_NETWORK_ACTUAL}" != "${EXPECTED_FOAF_NETWORK}" ]]; then
  echo "REFUSED: ${FOAF_CONTAINER} has FOAF_NETWORK='${FOAF_NETWORK_ACTUAL}', expected '${EXPECTED_FOAF_NETWORK}'."
  echo "         This script only wipes the testnet FOAF database. Aborting."
  exit 1
fi

echo "=== FOAF Demo Reset ==="
echo "  Snapshot date: ${SNAPSHOT_DATE}"
echo "  App snapshot:  ${APP_SNAPSHOT}"
echo "  Auth snapshot: ${AUTH_SNAPSHOT}"
echo "  App DB:   ${APP_DB_NAME}"
echo "  Auth DB:  ${AUTH_DB_NAME}"
echo "  FOAF DB:  foaf_testnet     (via ${FOAF_CONTAINER})"
echo

# --- Step 1: rebuild app schema from snapshot ------------------------------
# Drop the whole public schema first. Snapshot-local DROP statements cannot
# remove tables that were introduced after the snapshot was created; leaving
# one behind while schema_migrations is restored from the older snapshot makes
# the next migration fail with "table already exists".
#
# APP_DB_NAME has already passed the exact growoperative_demo allowlist above.
echo "[1/5] Rebuilding ${APP_DB_NAME} from ${APP_SNAPSHOT}..."
printf 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' | \
  psql_with_url "${BACKEND_CONTAINER}" "${APP_DATABASE_URL}"
restore_snapshot_to_url "${BACKEND_CONTAINER}" "${APP_DATABASE_URL}" "${APP_SNAPSHOT_PATH}"
echo "  OK"

# --- Step 2: restore auth identities + clear transactional auth state ------
# users.foaf_id (from step 1) must equal identities.foaf_id (auth side) or
# token verification silently fails at User.find_by(foaf_id: sub). The paired
# snapshot guarantees this — both halves were dumped from the same source.
# auth_signing_keys, service_tokens, and reserved_handles are env-specific
# infrastructure and intentionally left alone.
echo "[2/5] Loading ${AUTH_SNAPSHOT} into ${AUTH_DB_NAME} + clearing transactional auth state..."
psql_with_url "${AUTH_CONTAINER}" "${AUTH_DATABASE_URL}" <<'SQL'
TRUNCATE TABLE
  public.login_lockouts,
  public.recovery_phrases,
  public.recovery_attempts,
  public.revoked_jtis,
  public.invitations,
  public.contact_edges,
  public.audit_logs
RESTART IDENTITY CASCADE;
SQL
restore_snapshot_to_url "${AUTH_CONTAINER}" "${AUTH_DATABASE_URL}" "${AUTH_SNAPSHOT_PATH}"
echo "  OK"

# --- Step 3: clear foaf-testnet data ---------------------------------------
echo "[3/5] Clearing foaf_testnet tables..."
docker exec "${FOAF_CONTAINER}" bundle exec rails runner '
# Confirmed pending transfers reference their Operation, so dependants must be
# removed first or the database correctly rejects the reset on the foreign key.
models = [Foaf::TrustlineRecord, TrustlineEvent, TrustlineUpdateRequest,
          PendingTransfer, Operation, CurrencyNetwork]
models.each { |m| m.delete_all if defined?(m) }
puts "  Cleared: #{models.map(&:name).join(", ")}"
' 2>&1 | { grep -v "warning:" || true; }
echo "  OK"

# --- Step 4: deploy the FOAF currency network -----------------------------
# FOAF publishing needs a network to attach trustlines to. Without one,
# every publish call fails with "No network found on FOAF" and FOAF stays
# empty even though the app is generating activity.
echo "[4/5] Deploying FOAF currency network..."
docker exec "${FOAF_CONTAINER}" bundle exec rails runner '
network = NetworkService.deploy(
  name: "Growoperative Gardens (CAD)",
  symbol: "GGRO",
  decimals: 2,
  owner_address: "0x0000000000000000000000000000000000000001"
)
puts "  Network: #{network.address}"
' 2>&1 | { grep -v "warning:" || true; }
echo "  OK"

# --- Step 5: enable debug API + restart auth + backend-demo ---------------
# The trade test uses /v1/debug/invariants which is gated by the
# debug_api_enabled GlobalSetting. The dev_clean_* snapshot has no row
# for it, so production-mode demo backend defaults to 403.
# Restarting both auth and backend-demo flushes any cached state: rails'
# 5-min revocation-snapshot cache and auth's in-memory caches.
echo "[5/5] Enabling debug API + restarting ${AUTH_CONTAINER} and ${BACKEND_CONTAINER}..."
docker exec -e DISABLE_SPRING=1 "${BACKEND_CONTAINER}" bundle exec rails runner '
GlobalSetting.find_or_create_by(setting: "debug_api_enabled").update!(value: 1)
puts "  debug_api_enabled = 1"
' 2>&1 | { grep -v -E "warning:|Spring" || true; }

# Record this reset in the audit log, attributed to the operator who ran the
# script. This path bypasses DemoResetService, so it logs directly. Done before
# the restart, while the backend container is still up.
OPERATOR="${SUDO_USER:-$(whoami)}@$(hostname)"
docker exec -e DISABLE_SPRING=1 "${BACKEND_CONTAINER}" bundle exec rails runner "
AuditLog.record(
  action: 'demo.reset', status: 'succeeded', source: 'script',
  actor: 'operator:${OPERATOR}',
  metadata: { script: 'bin/foaf-reset-demo', app_snapshot: '${APP_SNAPSHOT}', auth_snapshot: '${AUTH_SNAPSHOT}' }
)
puts '  audit logged'
" 2>&1 | { grep -v -E "warning:|Spring" || true; }

docker restart "${AUTH_CONTAINER}" > /dev/null
docker restart "${BACKEND_CONTAINER}" > /dev/null
echo "  OK (allow ~15s for both to boot)"

echo
echo "=== Reset Complete ==="
echo "  Demo app DB restored from ${APP_SNAPSHOT}."
echo "  Demo auth DB identities restored from ${AUTH_SNAPSHOT}."
echo "  foaf_testnet cleared."
echo
echo "Next:"
echo "  TRADE_TEST_HOST=https://demo.growoperative.app python3 scripts/trade_test.py"
