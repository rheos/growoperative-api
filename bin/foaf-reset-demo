#!/bin/bash
#
# Reset the deployed demo to a clean trade-test baseline.
#
# Loads growoperative_demo from a dev_clean_* snapshot (which contains
# DROP TABLE IF EXISTS per table, so it cleanly replaces state), then
# wipes foaf_testnet so the FOAF side also starts empty. Shadow hooks
# will populate FOAF as the test creates trades.
#
# Uses the buddy user — no MySQL root credential needed. buddy has
# ALL PRIVILEGES on growoperative_demo, which is enough for full
# table drop/create/insert.
#
# This is the remote equivalent of bin/foaf-reset, which only works
# against local Docker. Run it on the Lightsail box.
#
# Usage (ON SERVER, from ~/railsbackend/):
#   ./bin/foaf-reset-demo [snapshot_file]
#
# Usage (FROM LAPTOP):
#   ssh -i keys/Growoperative-Rails-2gb.pem ubuntu@35.163.185.37 \
#       'cd ~/railsbackend && git pull && ./bin/foaf-reset-demo'
#
# Snapshot is restricted to dev_clean_* files. The trade test requires
# a starting state with no pre-existing requests, orders, contracts,
# or trustlines — other snapshots would invalidate it.
#
# Exit codes:
#   0  reset succeeded
#   1  bad snapshot or missing prerequisite
#   2  DB/container operation failed

set -euo pipefail

SNAPSHOT="${1:-dev_clean_2026-05-02.sql}"
SNAPSHOT_PATH="db/snapshots/${SNAPSHOT}"
BACKEND_CONTAINER="railsbackend-backend-demo-1"
FOAF_CONTAINER="foaf-testnet"

# --- Hard allowlist: refuse to touch anything but the demo + testnet -------
# These are the ONLY targets this script is allowed to wipe. If any of these
# expectations is violated, abort before any destructive operation.
EXPECTED_APP_DB="growoperative_demo"
EXPECTED_FOAF_NETWORK="testnet"

# --- Safety: snapshot must be a clean baseline ------------------------------
if [[ "${SNAPSHOT}" != dev_clean_* ]]; then
  echo "ERROR: Only dev_clean_* snapshots are allowed."
  echo "       Trade test requires no pre-existing requests/orders/trustlines."
  echo "       Requested: ${SNAPSHOT}"
  exit 1
fi

if [[ ! -f "${SNAPSHOT_PATH}" ]]; then
  echo "ERROR: Snapshot not found: ${SNAPSHOT_PATH}"
  exit 1
fi

# Snapshot must be transactionally empty. The dev_clean_* prefix is a name
# convention; this check is the actual contract. If a snapshot somehow ended
# up with orders/trustlines/etc baked in, refuse rather than silently load it.
TRANSACTIONAL_TABLES=(trustlines trustline_transactions orders item_requests request_contracts pending_payments)
for tbl in "${TRANSACTIONAL_TABLES[@]}"; do
  if grep -q "INSERT INTO \`${tbl}\`" "${SNAPSHOT_PATH}"; then
    echo "REFUSED: ${SNAPSHOT_PATH} contains INSERT INTO \`${tbl}\`."
    echo "         Trade-test snapshots must have zero transactional rows."
    echo "         Strip the INSERTs from the dump and retry."
    exit 1
  fi
done

# --- Load app DB creds from .env.demo --------------------------------------
ENV_FILE="$(dirname "$(realpath "$0")")/../.env.demo"
if [[ ! -f "${ENV_FILE}" ]]; then
  echo "ERROR: .env.demo not found at ${ENV_FILE}"
  exit 1
fi
# shellcheck disable=SC1090
set -a; source "${ENV_FILE}"; set +a
: "${DATABASE_HOST:?DATABASE_HOST not in .env.demo}"
: "${DATABASE_USERNAME:?DATABASE_USERNAME not in .env.demo}"
: "${DATABASE_PASSWORD:?DATABASE_PASSWORD not in .env.demo}"
: "${DATABASE_NAME:?DATABASE_NAME not in .env.demo}"

# --- Allowlist guard: DATABASE_NAME must be the demo DB -------------------
if [[ "${DATABASE_NAME}" != "${EXPECTED_APP_DB}" ]]; then
  echo "REFUSED: DATABASE_NAME in .env.demo is '${DATABASE_NAME}', not '${EXPECTED_APP_DB}'."
  echo "         This script only wipes the demo database. Aborting."
  exit 1
fi

# --- Sanity: required containers running -----------------------------------
for c in "${BACKEND_CONTAINER}" "${FOAF_CONTAINER}"; do
  if ! docker ps --format '{{.Names}}' | grep -qx "${c}"; then
    echo "ERROR: container ${c} not running. Can't proceed."
    exit 2
  fi
done

# --- Allowlist guard: foaf container must be running as testnet -----------
FOAF_NETWORK_ACTUAL="$(docker exec "${FOAF_CONTAINER}" sh -c 'echo $FOAF_NETWORK' 2>/dev/null || echo '')"
if [[ "${FOAF_NETWORK_ACTUAL}" != "${EXPECTED_FOAF_NETWORK}" ]]; then
  echo "REFUSED: ${FOAF_CONTAINER} has FOAF_NETWORK='${FOAF_NETWORK_ACTUAL}', expected '${EXPECTED_FOAF_NETWORK}'."
  echo "         This script only wipes the testnet FOAF database. Aborting."
  exit 1
fi

echo "=== FOAF Demo Reset ==="
echo "  Snapshot: ${SNAPSHOT}"
echo "  App DB:   ${DATABASE_NAME}  (@ ${DATABASE_HOST}, as ${DATABASE_USERNAME})"
echo "  FOAF DB:  foaf_testnet  (via ${FOAF_CONTAINER})"
echo

# --- Step 1: load snapshot into app DB -------------------------------------
# Snapshot has DROP TABLE IF EXISTS per table, so this cleanly replaces state.
# We pipe the dump through foaf-testnet's mysql client (the rails-box host
# doesn't have one installed, but the foaf-testnet image does).
echo "[1/3] Loading ${SNAPSHOT} into ${DATABASE_NAME}..."
# --skip-ssl: MySQL 8's self-signed cert fails MariaDB client's TLS handshake,
# but the connection is over private VPC so TLS is not needed for security.
# (foaf-testnet's mysql client is MariaDB 11.8 from Debian default-mysql-client;
# its SSL-disable flag is --skip-ssl, not --ssl-mode=DISABLED like upstream MySQL.)
docker exec -i "${FOAF_CONTAINER}" \
  sh -c "mysql --skip-ssl -h ${DATABASE_HOST} -u ${DATABASE_USERNAME} -p'${DATABASE_PASSWORD}' ${DATABASE_NAME}" \
  < "${SNAPSHOT_PATH}" \
  2>&1 | { grep -v "Using a password" || true; }
echo "  OK"

# --- Step 2: clear foaf-testnet data ---------------------------------------
echo "[2/4] Clearing foaf_testnet tables..."
docker exec "${FOAF_CONTAINER}" bundle exec rails runner '
models = [Foaf::TrustlineRecord, TrustlineEvent, TrustlineUpdateRequest,
          Operation, PendingTransfer, CurrencyNetwork]
models.each { |m| m.delete_all if defined?(m) }
puts "  Cleared: #{models.map(&:name).join(", ")}"
' 2>&1 | { grep -v "warning:" || true; }
echo "  OK"

# --- Step 3: deploy the FOAF currency network -----------------------------
# Shadow mirroring needs a network to attach trustlines to. Without one,
# every shadow call fails with "No network found on FOAF" and FOAF stays
# empty even though the app is generating activity.
echo "[3/4] Deploying FOAF currency network..."
docker exec "${FOAF_CONTAINER}" bundle exec rails runner '
network = NetworkService.deploy(
  name: "Growoperative Gardens (CAD)",
  symbol: "GGRO",
  decimals: 2,
  owner_address: "0x0000000000000000000000000000000000000001"
)
puts "  Network: #{network.address}"
' 2>&1 | { grep -v "warning:" || true; }
echo "  OK"

# --- Step 4: enable debug API + restart backend-demo ----------------------
# The trade test uses /v1/debug/invariants which is gated by the
# debug_api_enabled GlobalSetting. The dev_clean_* snapshot has no row
# for it, so production-mode demo backend defaults to 403.
echo "[4/4] Enabling debug API + restarting ${BACKEND_CONTAINER}..."
docker exec "${BACKEND_CONTAINER}" bundle exec rails runner '
GlobalSetting.find_or_create_by(setting: "debug_api_enabled").update!(value: 1)
puts "  debug_api_enabled = 1"
' 2>&1 | { grep -v -E "warning:|Spring" || true; }
docker restart "${BACKEND_CONTAINER}" > /dev/null
echo "  OK (allow ~15s for Rails to boot)"

echo
echo "=== Reset Complete ==="
echo "  Demo app DB restored from ${SNAPSHOT}."
echo "  foaf_testnet cleared."
echo
echo "Next:"
echo "  TRADE_TEST_HOST=https://demo.growoperative.app python3 scripts/trade_test.py"
