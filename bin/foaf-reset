#!/bin/bash
#
# Reset the app DB, auth DB, and FOAF DB to a clean synced starting state.
#
# Usage (from railsbackend/):
#   ./bin/foaf-reset [snapshot_date]
#
# Default snapshot date: 2026-05-23. The script loads two paired files:
#   db/snapshots/dev_clean_<date>.sql   → growoperative_development
#   db/snapshots/auth_clean_<date>.sql  → foaf_auth_development.identities
# Pairing matters because users.foaf_id (app side) must equal
# identities.foaf_id (auth side) for token verification to resolve.
#
# Auth signing keys, service tokens, and reserved-handle YAML state are
# left alone — those are infrastructure, not data.

set -e

SNAPSHOT_DATE="${1:-2026-05-23}"
APP_SNAPSHOT="dev_clean_${SNAPSHOT_DATE}.sql"
AUTH_SNAPSHOT="auth_clean_${SNAPSHOT_DATE}.sql"
APP_SNAPSHOT_PATH="db/snapshots/${APP_SNAPSHOT}"
AUTH_SNAPSHOT_PATH="db/snapshots/${AUTH_SNAPSHOT}"
RB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${FOAF_PROTOCOL_DIR:-}" ]; then
  FOAF_DIR="${FOAF_PROTOCOL_DIR}"
elif [ -d "${RB_DIR}/../foaf-protocol-ruby" ]; then
  FOAF_DIR="${RB_DIR}/../foaf-protocol-ruby"
elif [ -d "${RB_DIR}/../../foaf-protocol-ruby" ]; then
  FOAF_DIR="${RB_DIR}/../../foaf-protocol-ruby"
else
  echo "ERROR: foaf-protocol-ruby not found. Set FOAF_PROTOCOL_DIR to its local path."
  exit 1
fi

FOAF_COMPOSE_FILE="${FOAF_DIR}/docker-compose.yml"

if [ ! -f "${APP_SNAPSHOT_PATH}" ]; then
  echo "ERROR: App snapshot not found: ${APP_SNAPSHOT_PATH}"
  exit 1
fi

if [ ! -f "${AUTH_SNAPSHOT_PATH}" ]; then
  echo "ERROR: Auth snapshot not found: ${AUTH_SNAPSHOT_PATH}"
  echo "       Both halves are required so users.foaf_id and identities.foaf_id stay aligned."
  exit 1
fi

echo "=== FOAF Reset ==="
echo "Snapshot date: ${SNAPSHOT_DATE}"
echo "  App:  ${APP_SNAPSHOT}"
echo "  Auth: ${AUTH_SNAPSHOT}"
echo ""

# --- Step 1: Restore app DB ---
# NOTE: when this dev MySQL container is upgraded from 5.7 to 8, this command
# will fail with "TLS/SSL error: self-signed certificate" because MySQL 8
# requires TLS by default. Add an SSL-disable flag at that point — the right
# flag depends on the client: --ssl-mode=DISABLED for Oracle's mysql client,
# --skip-ssl for MariaDB's. (Prod's bin/foaf-reset-demo already uses --skip-ssl
# because the foaf-testnet container ships MariaDB.)
echo "[1/6] Restoring app DB..."
docker-compose exec -T db sh -c 'mysql -u root -p"rDKftaN-64" growoperative_development 2>/dev/null' < "${APP_SNAPSHOT_PATH}"
echo "  OK"

# --- Step 2: Run app migrations ---
echo "[2/6] Running app migrations..."
MIGRATE_OUTPUT="$(docker-compose exec backend rails db:migrate 2>&1)" || {
  echo "${MIGRATE_OUTPUT}" | grep -v "warning:" || true
  exit 1
}
echo "${MIGRATE_OUTPUT}" | grep -v "warning:" | grep -E "(migrat|==)" || true
echo "  OK"

# --- Step 2.5: Restore auth identities, clear transactional auth state ---
# identities.foaf_id must match users.foaf_id from step 1 or token verification
# silently fails at User.find_by(foaf_id: sub). The paired snapshot guarantees
# this — both halves were dumped from the same local DB state.
echo "[3/6] Restoring auth identities + clearing transactional auth state..."
docker exec -i service-db-1 mysql -u foaf_auth -ppassword foaf_auth_development 2>/dev/null <<SQL
SET FOREIGN_KEY_CHECKS=0;
TRUNCATE login_lockouts;
TRUNCATE recovery_phrases;
TRUNCATE recovery_attempts;
TRUNCATE revoked_jtis;
TRUNCATE invitations;
TRUNCATE contact_edges;
TRUNCATE audit_logs;
SET FOREIGN_KEY_CHECKS=1;
SQL
docker exec -i service-db-1 mysql -u foaf_auth -ppassword foaf_auth_development 2>/dev/null < "${AUTH_SNAPSHOT_PATH}"
echo "  OK"

# --- Step 4: Clear FOAF DB ---
echo "[4/6] Clearing FOAF DB..."
docker-compose -f "${FOAF_COMPOSE_FILE}" exec -T foaf bundle exec rails runner '
# Confirmed pending transfers reference their Operation, so dependants must be
# removed first or MySQL correctly rejects the reset on the foreign key.
[Foaf::TrustlineRecord, TrustlineEvent, TrustlineUpdateRequest, PendingTransfer,
 Operation, CurrencyNetwork].each(&:destroy_all)
puts "  Cleared."
' 2>&1
echo "  OK"

# --- Step 5: Generate FOAF addresses for app users ---
echo "[5/6] Generating FOAF addresses..."
docker-compose exec backend rails runner '
user_ids = (Trustline.pluck(:user_a_id) + Trustline.pluck(:user_b_id)).uniq
user_ids.each { |uid| Foaf::Signer.ensure_keypair!(User.find(uid)) rescue nil }
count = User.where.not(foaf_address: nil).count
User.where.not(foaf_address: nil).each { |u| puts "  #{u.user_name}: #{u.foaf_address}" }
puts "  #{count} users with trustlines addressed." if count > 0
puts "  No trustlines yet — addresses will be generated as users transact." if count == 0
' 2>&1 | grep -v "warning:"
echo "  OK"

# --- Step 6: Seed FOAF with current trustline state ---
echo "[6/6] Seeding FOAF..."

# Export trustline data from app, pipe directly into FOAF
docker-compose exec -T backend rails runner '
require "json"
data = Trustline.where(is_active: true).map do |tl|
  a = User.find(tl.user_a_id)
  b = User.find(tl.user_b_id)
  { user_a: a.user_name, user_b: b.user_name,
    addr_a: a.foaf_address, addr_b: b.foaf_address,
    credit_limit_a_to_b: tl.credit_limit_a_to_b.to_f,
    credit_limit_b_to_a: tl.credit_limit_b_to_a.to_f,
    balance: tl.current_balance.to_f }
end
puts data.to_json
' 2>&1 | grep -v "warning:" | grep '^\[' > /tmp/foaf_seed.json

docker cp /tmp/foaf_seed.json "$(docker-compose -f "${FOAF_COMPOSE_FILE}" ps -q foaf)":/tmp/foaf_seed.json 2>/dev/null

docker-compose -f "${FOAF_COMPOSE_FILE}" exec -T foaf bundle exec rails runner '
require "json"
data = JSON.parse(File.read("/tmp/foaf_seed.json"))

network = NetworkService.deploy(
  name: "Growoperative Gardens (CAD)", symbol: "GGRO", decimals: 2,
  owner_address: "0x0000000000000000000000000000000000000001"
)
puts "  Network: #{network.address}"

data.each do |tl|
  addr_a, addr_b = tl["addr_a"], tl["addr_b"]
  app_a_to_b = tl["credit_limit_a_to_b"]
  app_b_to_a = tl["credit_limit_b_to_a"]
  app_balance = tl["balance"]

  # Canonical order + semantic mapping (app limits are inverted from FOAF)
  if addr_a < addr_b
    foaf_given = app_b_to_a
    foaf_received = app_a_to_b
    foaf_balance = -app_balance
    canon_a, canon_b = addr_a, addr_b
  else
    foaf_given = app_a_to_b
    foaf_received = app_b_to_a
    foaf_balance = app_balance
    canon_a, canon_b = addr_b, addr_a
  end

  # Two-stage trustline creation
  TrustlineService.update_trustline(
    network: network, creditor_address: canon_a, debtor_address: canon_b,
    creditline_given: BigDecimal(foaf_given.to_s),
    creditline_received: BigDecimal(foaf_received.to_s)
  )
  TrustlineService.update_trustline(
    network: network, creditor_address: canon_b, debtor_address: canon_a,
    creditline_given: BigDecimal(foaf_received.to_s),
    creditline_received: BigDecimal(foaf_given.to_s)
  )

  # Set balance directly (snapshot state)
  record = Foaf::TrustlineRecord.where(user_a_address: canon_a, user_b_address: canon_b).first!
  record.update_column(:balance, foaf_balance) if foaf_balance != 0

  puts "  #{tl["user_a"]} <-> #{tl["user_b"]}: balance=#{foaf_balance}"
end
puts "  Done: #{data.size} trustlines seeded."
' 2>&1

# --- Verify ---
echo ""
echo "=== Verify ==="
sleep 2
curl -s http://localhost:3001/v1/debug/foaf/reconcile 2>/dev/null | \
  python3 -c "
import json, sys
data = json.load(sys.stdin)
s = data['summary']
print(f\"Trustlines: {s['total']}  Matches: {s['matches']}  Discrepancies: {s['discrepancies']}  Unlinked: {s['unlinked']}\")
for tl in data['trustlines']:
    status = 'OK' if tl['match'] else 'DIFF'
    print(f'  {status}  {tl[\"user_a\"]} <-> {tl[\"user_b\"]}')
" 2>/dev/null || echo "  (reconciliation not available — backend may need restart)"

echo ""
echo "=== Reset Complete ==="
echo "Both databases synced. Shadow hooks are active."
echo "  curl http://localhost:3001/v1/debug/foaf/reconcile"
