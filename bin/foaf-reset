#!/bin/bash
#
# Reset both the app DB and FOAF DB to a clean starting state.
# Restores from the pre-shipment snapshot, runs migrations,
# generates FOAF addresses, clears FOAF, seeds FOAF with matching state.
#
# Usage (from railsbackend/):
#   ./bin/foaf-reset [snapshot_file]
#
# Default snapshot: dev_preshipment_rebalanced_2026-04-13.sql

set -e

SNAPSHOT="${1:-dev_preshipment_rebalanced_2026-04-13.sql}"
SNAPSHOT_PATH="db/snapshots/${SNAPSHOT}"

if [ ! -f "${SNAPSHOT_PATH}" ]; then
  echo "ERROR: Snapshot not found: ${SNAPSHOT_PATH}"
  exit 1
fi

echo "=== FOAF Reset ==="
echo "Snapshot: ${SNAPSHOT}"
echo ""

# --- Step 1: Restore app DB ---
echo "[1/5] Restoring app DB..."
docker-compose exec -T db sh -c 'mysql -u root -p"rDKftaN-64" growoperative_development 2>/dev/null' < "${SNAPSHOT_PATH}"
echo "  OK"

# --- Step 2: Run app migrations ---
echo "[2/5] Running migrations..."
docker-compose exec backend rails db:migrate 2>&1 | grep -v "warning:" | grep -E "(migrat|==)" || true
echo "  OK"

# --- Step 3: Clear FOAF DB ---
echo "[3/5] Clearing FOAF DB..."
docker-compose -f ../foaf-protocol-ruby/docker-compose.yml exec -T foaf bundle exec rails runner '
[Foaf::TrustlineRecord, TrustlineEvent, TrustlineUpdateRequest, Operation,
 PendingTransfer, Identity, CurrencyNetwork].each(&:destroy_all)
puts "  Cleared."
' 2>&1
echo "  OK"

# --- Step 4: Generate FOAF addresses + seed FOAF ---
echo "[4/5] Generating addresses and seeding FOAF..."
docker-compose exec backend rails runner '
require "digest"
require "net/http"
require "json"

foaf_url = ENV.fetch("FOAF_API_URL", "http://host.docker.internal:3002")

def foaf_post(base, path, body)
  uri = URI("#{base}#{path}")
  http = Net::HTTP.new(uri.host, uri.port)
  req = Net::HTTP::Post.new(uri.path, "Content-Type" => "application/json")
  req.body = body.to_json
  resp = http.request(req)
  JSON.parse(resp.body) rescue nil
end

def foaf_put(base, path, body = {})
  uri = URI("#{base}#{path}")
  http = Net::HTTP.new(uri.host, uri.port)
  req = Net::HTTP::Put.new(uri.path, "Content-Type" => "application/json")
  req.body = body.to_json
  resp = http.request(req)
  JSON.parse(resp.body) rescue nil
end

# Collect users with trustlines
user_ids = (Trustline.pluck(:user_a_id) + Trustline.pluck(:user_b_id)).uniq
users = {}

user_ids.each do |uid|
  u = User.find(uid)
  addr = "0x" + Digest::SHA256.hexdigest("growoperative:#{u.user_name}")[0..39]
  pubkey = "04" + Digest::SHA256.hexdigest("pub:growoperative:#{u.user_name}") +
           Digest::SHA256.hexdigest("pub2:growoperative:#{u.user_name}")

  # Save to app DB
  u.update_columns(foaf_address: addr, foaf_public_key: pubkey, foaf_registered: true)

  # Register with FOAF
  foaf_post(foaf_url, "/api/v1/identities", { public_key: pubkey })

  users[u.user_name] = { id: u.id, address: addr }
  puts "  #{u.user_name}: #{addr}"
end

# Deploy network on FOAF (via direct runner since we need the network address)
# We cannot deploy via API yet, so we use a known seed approach
puts ""
puts "  Users registered. Now seeding trustlines via FOAF rails runner..."
File.write("/tmp/foaf_users.json", users.to_json)

# Dump trustline data
tl_data = Trustline.where(is_active: true).map do |tl|
  a = User.find(tl.user_a_id)
  b = User.find(tl.user_b_id)
  {
    user_a: a.user_name,
    user_b: b.user_name,
    addr_a: users[a.user_name][:address],
    addr_b: users[b.user_name][:address],
    credit_limit_a_to_b: tl.credit_limit_a_to_b.to_f,
    credit_limit_b_to_a: tl.credit_limit_b_to_a.to_f,
    balance: tl.current_balance.to_f
  }
end
File.write("/tmp/foaf_trustlines.json", tl_data.to_json)
puts "  Exported #{tl_data.size} trustlines."
' 2>&1 | grep -v "warning:"
echo "  OK"

# --- Step 5: Seed FOAF trustlines ---
echo "[5/5] Seeding FOAF trustlines..."

# Copy data from app container to host, then into FOAF container
docker-compose exec -T backend cat /tmp/foaf_trustlines.json > /tmp/foaf_tl.json 2>/dev/null
docker cp /tmp/foaf_tl.json "$(docker-compose -f ../foaf-protocol-ruby/docker-compose.yml ps -q foaf)":/tmp/foaf_tl.json 2>/dev/null

docker-compose -f ../foaf-protocol-ruby/docker-compose.yml exec -T foaf bundle exec rails runner '
require "json"

data = JSON.parse(File.read("/tmp/foaf_tl.json"))

# Deploy network
network = NetworkService.deploy(
  name: "Growoperative Gardens (CAD)", symbol: "GGRO", decimals: 2,
  owner_address: "0x0000000000000000000000000000000000000001"
)
puts "  Network: #{network.address}"

data.each do |tl|
  addr_a = tl["addr_a"]
  addr_b = tl["addr_b"]
  app_a_to_b = tl["credit_limit_a_to_b"]
  app_b_to_a = tl["credit_limit_b_to_a"]
  app_balance = tl["balance"]

  # Canonical order and semantic mapping
  if addr_a < addr_b
    foaf_given = app_b_to_a
    foaf_received = app_a_to_b
    foaf_balance = -app_balance
    canon_a, canon_b = addr_a, addr_b
  else
    foaf_given = app_a_to_b
    foaf_received = app_b_to_a
    foaf_balance = app_balance
    canon_a, canon_b = addr_b, addr_a
  end

  # Two-stage trustline creation
  TrustlineService.update_trustline(
    network: network, creditor_address: canon_a, debtor_address: canon_b,
    creditline_given: BigDecimal(foaf_given.to_s),
    creditline_received: BigDecimal(foaf_received.to_s)
  )
  TrustlineService.update_trustline(
    network: network, creditor_address: canon_b, debtor_address: canon_a,
    creditline_given: BigDecimal(foaf_received.to_s),
    creditline_received: BigDecimal(foaf_given.to_s)
  )

  # Set balance directly (snapshot state)
  record = Foaf::TrustlineRecord.where(user_a_address: canon_a, user_b_address: canon_b).first!
  record.update_column(:balance, foaf_balance) if foaf_balance != 0

  puts "  #{tl["user_a"]}<->#{tl["user_b"]}: balance=#{foaf_balance}"
end
' 2>&1
echo "  OK"

# --- Verify ---
echo ""
echo "=== Verify ==="
curl -s http://localhost:3001/v1/debug/foaf/reconcile 2>/dev/null | \
  python3 -c "
import json, sys
data = json.load(sys.stdin)
s = data['summary']
print(f\"Trustlines: {s['total']}  Matches: {s['matches']}  Discrepancies: {s['discrepancies']}  Unlinked: {s['unlinked']}\")
for tl in data['trustlines']:
    status = 'OK' if tl['match'] else 'DIFF'
    print(f\"  {status}  {tl['user_a']} <-> {tl['user_b']}\")
    if not tl['match']:
        for d in tl['discrepancies']:
            print(f\"       {d}\")
" 2>/dev/null || echo "  (reconciliation endpoint not available)"

echo ""
echo "=== Reset Complete ==="
echo "Both databases are in sync. Make transactions and check:"
echo "  curl http://localhost:3001/v1/debug/foaf/reconcile"
