# Local development only. Copy to .env; never commit the filled-in file.
FRONTEND_URL=http://localhost:3000

# Generate your own value: openssl rand -hex 64
SECRET_KEY_BASE=
# Optional separate Devise keys; blank values use SECRET_KEY_BASE.
DEVISE_SECRET_KEY=
DEVISE_JWT_SECRET_KEY=

# Used only when creating the initial local "robin" bootstrap account.
# Blank generates an unshared random password. Existing passwords are preserved.
SEED_ADMIN_PASSWORD=

# Full login/contact flows need a separately configured FOAF auth service.
FOAF_AUTH_BASE_URL=http://host.docker.internal:3013
FOAF_AUTH_PUBLIC_BASE_URL=http://localhost:3013
FOAF_AUTH_SERVICE_TOKEN=
EXPO_ACCESS_TOKEN=
# Opt in only after configuring the local FOAF credit service.
FOAF_WRITE_ENABLED=false
FOAF_SHARED_READS=false
FOAF_SHARED_WRITES=false

# Leave these blank for local file uploads. Configure S3 only when needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_S3_BUCKET=
